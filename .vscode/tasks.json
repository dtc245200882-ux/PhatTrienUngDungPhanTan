{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Docker Compose Stack",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"-d",
				"--wait",
				"--wait-timeout",
				"90"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Docker Compose Status",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"ps",
				"-a"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect Docker Compose Logs",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"logs",
				"--tail",
				"60",
				"video-api",
				"video-worker",
				"web-client",
				"minio",
				"mongodb",
				"rabbitmq"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Recheck Docker Compose Status",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"ps",
				"-a"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect Web Static Files",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"exec",
				"-T",
				"web-client",
				"sh",
				"-c",
				"find /app -maxdepth 5 -type f | sort | head -100"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Locate Blazor Framework Script",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"exec",
				"-T",
				"web-client",
				"sh",
				"-c",
				"find /usr/share/dotnet -name blazor.web.js -o -name blazor.server.js"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Inspect Static Asset Manifest",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"exec",
				"-T",
				"web-client",
				"sh",
				"-c",
				"grep -n 'blazor.web.js' /app/Web.Client.staticwebassets.endpoints.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find Framework Asset Entry",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"exec",
				"-T",
				"web-client",
				"grep",
				"blazor.web.js",
				"/app/Web.Client.staticwebassets.endpoints.json"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Rebuild Web Client Image",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"build",
				"web-client"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Locate SDK Blazor Assets",
			"type": "shell",
			"command": "docker",
			"args": [
				"run",
				"--rm",
				"--entrypoint",
				"sh",
				"mcr.microsoft.com/dotnet/sdk:10.0",
				"-c",
				"find /usr/share/dotnet /root/.nuget -name blazor.web.js -o -name blazor.server.js 2>/dev/null"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Rebuild Web Client Assets",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"build",
				"web-client"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Restart Web Client Container",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"-d",
				"web-client"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check RabbitMQ Port Probe",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"exec",
				"-T",
				"rabbitmq",
				"rabbitmq-diagnostics",
				"-q",
				"check_port_connectivity"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate Compose Healthcheck",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"config",
				"--quiet"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Recreate Broker and Worker",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"-d",
				"--force-recreate",
				"rabbitmq",
				"video-worker"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final Compose Service Status",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"ps",
				"-a"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify Worker Startup Log",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"logs",
				"--tail",
				"30",
				"video-worker"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final Compose Status",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"ps",
				"-a"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Initialize Git Repository",
			"type": "shell",
			"command": "git",
			"args": [
				"init"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage Repository Files",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"."
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check Staged Files",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Create Initial Git Commit",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				".vscode/tasks.json"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}